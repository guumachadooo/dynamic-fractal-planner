{
  "schema_version": 5,
  "plugin_version": "2.22.0",
  "docs_format_version": 1,
  "project_name": "dynamic-fractal-planner",
  "planner_mode": "auto",
  "read_budget": {
    "max_full_read_lines": 300,
    "max_slice_lines": 250
  },
  "secret_guard": {
    "enabled": true
  },
  "blast_radius": {
    "simple_tier_max_files": 3
  },
  "code_weight_limits": {
    "enabled": true,
    "warn_lines": 1200,
    "warn_lines_all": 2000
  },
  "memory_weight_limits": {
    "project_history_max_lines": 150,
    "project_history_max_kb": 28,
    "external_sync_max_kb": 48
  },
  "file_budget_limits": {
    "enabled": true,
    "warn_files": 850,
    "fail_files": 920,
    "hard_platform_cap": 999
  },
  "blueprint": {
    "dir": ".agents/docs/blueprints",
    "hub_file": ".agents/docs/PLANS_HUB.md",
    "require_by_default": false,
    "default_min_tier": 2,
    "require_pre_resume_hygiene": true
  },
  "adversarial_qa": {
    "enabled": false,
    "contracts_file": ".agents/qa/regression_contracts.json",
    "strict_verify": true
  },
  "extra_requests_file": ".agents/docs/EXTRA_REQUESTS.md",
  "memory_feedback": {
    "enabled": true,
    "min_code_files": 2,
    "docs": [
      ".agents/docs/PROJECT_HISTORY.md",
      ".agents/docs/SAVED_IDEAS.md",
      "AGENTS.md"
    ]
  },
  "plugin_evolution": {
    "enabled": true,
    "auto_sync_higher_version": true,
    "plugin_path": ".",
    "plugin_sync_doc": ".agents/docs/EXTERNAL_AI_SYNC.md",
    "host_sync_doc": ".agents/docs/EXTERNAL_AI_SYNC.md"
  },
  "delegation": {
    "enabled": true,
    "thin_coordinator_min_tier": 2,
    "max_subagent_reply_lines": 20,
    "require_explicit_model": true,
    "prefer_cheap_models": true,
    "enforce_google_only": true,
    "exempt_subagent_types": [
      "image-generator"
    ],
    "model_tiers": {
      "trivial": "flash_lite",
      "routine": "flash",
      "complex": "pro"
    },
    "allowed_model_vendors": [
      "google",
      "gemini"
    ],
    "blocked_model_patterns": [
      "claude",
      "anthropic",
      "opus",
      "sonnet",
      "haiku",
      "gpt-",
      "gpt4",
      "gpt5",
      "chatgpt",
      "openai",
      "o1-",
      "o3-",
      "o4-",
      "codex"
    ],
    "sequential_proot_ops": [
      "dotnet_build",
      "heavy_tests",
      "git_push"
    ],
    "sub_subagent": {
      "allow_nesting": true,
      "default_model": "flash_lite",
      "swarm_medium_model": "gemini-4-hydrogen-medium",
      "allow_medium_tier": true
    }
  },
  "build_rules": [
    {
      "label": "plugin-tests",
      "command": "python3 -B tests/run_plugin_tests.py --fast",
      "trigger_extensions": [
        ".py"
      ],
      "run_on_force": true
    }
  ],
  "domains": {}
}
